# App metadata database (flows, connections, runs, audit log) - NOT the source data warehouse
DATABASE_URL=sqlite:///./app_metadata.db

# Claude API key - used only for NL -> plan generation, never sees credentials
ANTHROPIC_API_KEY=sk-ant-...

# Fernet key for encrypting stored connection secrets (DB passwords, Tableau PATs).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Row-count growth ratio above which a join result is flagged as a possible blow-up
JOIN_ANOMALY_RATIO=1.5

# Max rows sampled from a source table and shown to the LLM as context
SCHEMA_SAMPLE_ROW_LIMIT=20

# Where generated .hyper files are written before being published
HYPER_OUTPUT_DIR=./hyper_output

# Row chunk size for streaming a full execute (never loads the whole result at once)
EXECUTE_CHUNK_SIZE=50000
